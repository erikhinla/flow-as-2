# Live client product. Copy to the repo root as .env and replace every value.
# Do not commit .env.

BIZBRAIN_ENV=prod
BIZBRAIN_API_TOKEN=replace_with_long_random_token
FLOW_DB_PASSWORD=replace_with_strong_password
WEBHOOK_API_KEY=replace_with_webhook_secret

DASHBOARD_BASIC_AUTH_USER=admin
DASHBOARD_BASIC_AUTH_PASSWORD=replace_with_dashboard_password

# Leave blank to serve the diagnostic on the desk host at /diagnostic.
# Set both hosts plus ACME_EMAIL to turn on HTTPS.
DIAGNOSTIC_PUBLIC_URL=
DIAGNOSTIC_HOST=
DESK_HOST=
ACME_EMAIL=

# Set to 1 when a reverse proxy already on the host (for example a systemd Caddy)
# terminates HTTPS. The stack then binds to 127.0.0.1 and does not start its own Caddy.
EXTERNAL_PROXY=

# Telegram bot. The gateway serves POST /telegram/webhook and checks the
# X-Telegram-Bot-Api-Secret-Token header against TELEGRAM_WEBHOOK_SECRET.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Diagnostic-complete alerts from the bot go to this chat (Erik's private chat id).
TELEGRAM_ALERT_CHAT_ID=
DESK_PUBLIC_URL=

# ArVA client agent (profile "arva"). Leave ARVA_API_KEY blank to skip it.
ARVA_API_KEY=
ARVA_SESSION_TOKEN=
ARVA_VERTEX_PROJECT_ID=
ARVA_VERTEX_REGION=global
# Host path of the arva-agent Vertex service-account JSON (Vertex AI User only).
ARVA_VERTEX_SA_FILE=

# Approval-gated handoff to the host Hermes. The desk proxy adds HANDOFF_DESK_TOKEN.
HANDOFF_DESK_TOKEN=
HERMES_BRIDGE_URL=http://host.docker.internal:18790
HERMES_BRIDGE_TOKEN=

# 0.0.0.0 publishes the diagnostic and desk on the VPS.
# scripts/netcup/deploy.sh switches this to 127.0.0.1 when the HTTPS hosts are set.
LIVE_BIND=0.0.0.0
DIAGNOSTIC_PORT=8080
DESK_PORT=5173
