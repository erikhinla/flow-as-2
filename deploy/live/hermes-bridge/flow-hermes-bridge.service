[Unit]
Description=FLOW-AS approved handoff bridge to the host Hermes (hermes -z, limited toolsets)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/flow-hermes-bridge.env
ExecStart=/usr/bin/python3 /opt/flow-as/deploy/live/hermes-bridge/flow_hermes_bridge.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
